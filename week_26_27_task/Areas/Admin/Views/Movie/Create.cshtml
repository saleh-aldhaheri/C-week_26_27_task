@model MovieWithCategoriesCinemasActors

<form method="post" enctype="multipart/form-data">

    <div class="row g-3">

        <div class="col-12 col-md-6">
            <label asp-for="Movie.Title" class="form-label"></label>
            <input asp-for="Movie.Title" class="form-control" minlength="3" maxlength="150" />
            <span class="text-danger" asp-validation-for="Movie.Title"></span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Movie.Price" class="form-label"></label>
            <input asp-for="Movie.Price" type="number" step="0.01" min="0" class="form-control" />
            <span class="text-danger" asp-validation-for="Movie.Price"></span>
        </div>

        <div class="col-12">
            <label asp-for="Movie.Description" class="form-label"></label>
            <textarea asp-for="Movie.Description" class="form-control" rows="3" maxlength="1000"></textarea>
            <div class="form-text">Optional, up to 1000 characters.</div>
            <span class="text-danger" asp-validation-for="Movie.Description"></span>
        </div>

        <div class="col-12 col-md-3">
            <label asp-for="SelectedCategroyId" class="form-label"></label>
            <select asp-for="SelectedCategroyId" class="form-select">
                <option value="">Select a category</option>
                @foreach (var category in Model.Categories ?? Enumerable.Empty<Category>())
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
            <span class="text-danger" asp-validation-for="SelectedCategroyId"></span>
        </div>

        <div class="col-12 col-md-3">
            <label asp-for="SelectedCinemaId" class="form-label"></label>
            <select asp-for="SelectedCinemaId" class="form-select" id="cinemaSelect">
                <option value="">Select a cinema</option>
                @foreach (var cinema in Model.CinemasWithAuditoriums ?? Enumerable.Empty<Cinema>())
                {
                    <option value="@cinema.Id">@cinema.Name</option>
                }
            </select>
            <span class="text-danger" asp-validation-for="SelectedCinemaId"></span>
        </div>

        <div class="col-12 col-md-3">
            <label asp-for="SelectedAuditoriumId" class="form-label"></label>
            <select asp-for="SelectedAuditoriumId" class="form-select" id="auditoriumSelect">
                <option value="">Select a cinema first</option>
                @foreach (var cinema in Model.CinemasWithAuditoriums ?? Enumerable.Empty<Cinema>())
                {
                    foreach (var auditorium in cinema.Auditoriums)
                    {
                        <option value="@auditorium.Id" data-cinema-id="@cinema.Id">@auditorium.Name</option>
                    }
                }
            </select>
            <span class="text-danger" asp-validation-for="SelectedAuditoriumId"></span>
        </div>

        <div class="col-12 col-md-3">
            <label asp-for="Movie.StartAt" class="form-label"></label>
            <input asp-for="Movie.StartAt" type="datetime-local" class="form-control" />
            <span class="text-danger" asp-validation-for="Movie.StartAt"></span>
        </div>

        <div class="col-12">
            <label class="form-label">Actors</label>
            <div class="border rounded p-3" style="max-height: 220px; overflow-y: auto;">
                @if (Model.Actors is not null && Model.Actors.Any())
                {
                    <div class="row row-cols-2 row-cols-md-3 g-2">
                        @foreach (var actor in Model.Actors)
                        {
                            var isChecked = Model.SelectedActorIds is not null && Model.SelectedActorIds.Contains(actor.Id);
                            <div class="col">
                                <div class="form-check d-flex align-items-center gap-2">
                                    <input class="form-check-input mt-0"
                                           type="checkbox"
                                           name="SelectedActorIds"
                                           value="@actor.Id"
                                           id="actor_@actor.Id"
                                           checked="@isChecked" />
                                            
                                    <img src="~/assets/images/actor/@actor.Img"
                                         alt="@actor.FullName"
                                         class="rounded-circle"
                                         style="width: 28px; height: 28px; object-fit: cover; flex-shrink: 0;" />

                                    <label class="form-check-label mb-0 text-truncate" for="actor_@actor.Id">
                                        @actor.FullName
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No actors available.</p>
                }
            </div>
            <div class="form-text">Optional, select all actors that appear in this movie.</div>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Image" class="form-label"></label>
            <input asp-for="Image" type="file" class="form-control" accept="image/*" id="mainImageInput" required />
            <div class="form-text">Required, the main poster image.</div>
            <span class="text-danger" asp-validation-for="Image"></span>
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label d-block">Main image preview</label>
            <img id="mainImagePreview"
                 src="#"
                 alt="Selected main image preview"
                 class="rounded shadow-sm d-none"
                 style="width: 120px; height: 120px; object-fit: cover;" />
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="Images" class="form-label"></label>
            <input asp-for="Images" type="file" class="form-control" accept="image/*" id="subImagesInput" multiple />
            <div class="form-text">Optional, additional gallery images.</div>
            <span class="text-danger" asp-validation-for="Images"></span>
        </div>

        <div class="col-12">
            <label class="form-label d-block">Gallery preview</label>
            <div id="subImagesPreview" class="d-flex flex-wrap gap-2"></div>
        </div>

    </div>

    <button type="submit" class="btn btn-primary mt-4">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('mainImageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById('mainImagePreview');

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = '#';
                preview.classList.add('d-none');
            }
        });

        document.getElementById('subImagesInput').addEventListener('change', function (event) {
            const files = Array.from(event.target.files || []);
            const container = document.getElementById('subImagesPreview');
            container.innerHTML = '';

            files.forEach(function (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.alt = 'Gallery image preview';
                    img.className = 'rounded shadow-sm';
                    img.style.width = '90px';
                    img.style.height = '90px';
                    img.style.objectFit = 'cover';
                    container.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        });

        const cinemaSelect = document.getElementById('cinemaSelect');
        const auditoriumSelect = document.getElementById('auditoriumSelect');

        const auditoriumChoices = Array.from(auditoriumSelect.options)
            .filter(function (option) { return option.dataset.cinemaId; })
            .map(function (option) {
                return { value: option.value, text: option.text, cinemaId: option.dataset.cinemaId };
            });

        const initialAuditoriumId = auditoriumSelect.value;

        function renderAuditoriums(preserveSelection) {
            const cinemaId = cinemaSelect.value;

            auditoriumSelect.innerHTML = '';

            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.text = cinemaId ? 'Select an auditorium' : 'Select a cinema first';
            auditoriumSelect.appendChild(placeholder);

            auditoriumChoices
                .filter(function (choice) { return choice.cinemaId === cinemaId; })
                .forEach(function (choice) {
                    const option = document.createElement('option');
                    option.value = choice.value;
                    option.text = choice.text;

                    if (preserveSelection && choice.value === initialAuditoriumId) {
                        option.selected = true;
                    }

                    auditoriumSelect.appendChild(option);
                });
        }

        cinemaSelect.addEventListener('change', function () {
            renderAuditoriums(false);
        });

        renderAuditoriums(true);
    </script>
}
