@using week_26_27.ViewModels
@model UserWithRoleVM

<form method="post">

    <input type="hidden" asp-for="UserId" />

    <div class="mb-3">
        <label asp-for="applicationUser.UserName" class="form-label"></label>
        <input asp-for="applicationUser.UserName" class="form-control" />
        <span asp-validation-for="applicationUser.UserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="applicationUser.Email" class="form-label"></label>
        <input asp-for="applicationUser.Email" class="form-control" />
        <span asp-validation-for="applicationUser.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="applicationUser.FirstName" class="form-label"></label>
        <input asp-for="applicationUser.FirstName" class="form-control" />
        <span asp-validation-for="applicationUser.FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="applicationUser.LastName" class="form-label"></label>
        <input asp-for="applicationUser.LastName" class="form-control" />
        <span asp-validation-for="applicationUser.LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SelectRoleName" class="form-label">Role</label>
        <select asp-for="SelectRoleName" class="form-select">
            @foreach (var role in Model.Roles)
            {
                if (role.Name == Model.SelectRoleName)
                {
                    <option value="@role.Name" selected>
                        @role.NormalizedName
                    </option>
                }
                else
                {
                    <option value="@role.Name">
                        @role.NormalizedName
                    </option>
                }
            }
        </select>
        <span asp-validation-for="SelectRoleName" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}