@using week_26_27.ViewModels
@using week_26_27.Utilities
@model UserWithFilterAndPaginationVM

<div id="tableExample5">

    <form method="get"
          asp-controller="@ControllerConstants.USER_CONTROLLER"
          asp-action="Index"
          asp-area="@AreaConstants.ADMIN_AREA">

        <div class="row justify-content-between g-0 mb-3">
            <div class="col-auto col-sm-5">
                <div class="input-group">
                    <input class="form-control form-control-sm shadow-none" type="search" placeholder="Search..." aria-label="search" name="search" value="@Model.Search" />
                    <div class="input-group-text bg-transparent"><span class="fa fa-search fs--1 text-600"></span></div>
                </div>
            </div>

            <div class="col-auto col-sm-2">
                <select class="form-select" aria-label="Page size" name="Pagination.PageSize">
                    @foreach (var size in new[] { 5, 15, 25, 50, 75, 100 })
                    {
                        if (Model.Pagination.PageSize == size)
                        {
                            <option value="@size" selected>@size / page</option>
                        }
                        else
                        {
                            <option value="@size">@size / page</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div class="d-flex gap-2 mb-3">
            <button type="submit" class="btn btn-sm btn-falcon-primary">Apply</button>
            <a class="btn btn-sm btn-falcon-default"
               asp-controller="@ControllerConstants.USER_CONTROLLER"
               asp-action="Index"
               asp-area="@AreaConstants.ADMIN_AREA">Reset</a>
        </div>
    </form>

    <div class="table-responsive scrollbar">
        <table class="table table-bordered table-striped fs--1 mb-0">
            <thead class="bg-200 text-900">
                <tr>
                    <th class="align-middle">Username</th>
                    <th class="align-middle">First Name</th>
                    <th class="align-middle"> Last Name</th>
                    <th class="align-middle">Email</th>
                    <th class="align-middle">Verfied</th>
                    <th class="align-middle text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.UsersRoles)
                {
                    <tr>
                        <th class="align-middle">@item.Key.UserName</th>
                        <td class="align-middle">@item.Key.FirstName</td>
                        <td class="align-middle">@item.Key.LastName</td>
                        <td class="align-middle">@item.Key.Email</td>

                        @if (@item.Key.EmailConfirmed)
                        {
                            <td class="align-middle">Active</td>
                        }
                        else
                        {
                            <td class="align-middle">InActive</td>
                        }
                        <td class="align-middle">
                            @if(User.IsInRole(RoleConstants.SUPER_ADMIN))
                            {
                                 <form asp-controller="@ControllerConstants.USER_CONTROLLER"
                                      asp-action="ChangeRole"
                                      asp-area="@AreaConstants.ADMIN_AREA"
                                      method="post" class="d-flex gap-2 align-items-center">

                                    <input type="hidden" name="id" value="@item.Key.Id" />
                                
                                    <select name="role" id="select_changer_role_@item.Key.Id" class="form-select form-select-sm">
                                        @foreach(var role in Model.Roles)
                                        {
                                            if(role.Name == item.Value)
                                            {
                                                <option value="@role.Name" selected>
                                                    @role.NormalizedName
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@role.Name">
                                                    @role.NormalizedName
                                                </option>
                                            }
                                        }
                                    </select>

                                    <button type="submit" class="btn btn-sm btn-warning" title="Change Role">
                                        <span class="fas fa-edit"></span>
                                    </button>
                                </form>
                            }else
                            {
                                <select name="role" id="select_changer_role_@item.Key.Id" class="form-select form-select-sm" disabled>
                                    @foreach(var role in Model.Roles)
                                    {
                                        if(role.Name == item.Value)
                                        {
                                            <option value="@role.Name" selected>
                                                @role.NormalizedName
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@role.Name">
                                                @role.NormalizedName
                                            </option>
                                        }
                                    }
                              </select>
                            }
                        </td>

                        <td class="align-middle white-space-nowrap text-end pe-3">
                            @if(User.IsInRole(RoleConstants.SUPER_ADMIN))
                            {
                           
                                    <div class="d-flex gap-3 justify-content-end">
                                        <!-- Change role form moved to the left column -->
                                        <a class="text-warning" title="Update"
                                           asp-controller="@ControllerConstants.USER_CONTROLLER"
                                           asp-action="Update"
                                           asp-area="@AreaConstants.ADMIN_AREA"
                                           asp-route-id="@item.Key.Id">
                                            <span class="fas fa-edit"></span>
                                        </a>
                                        <a class="text-danger btn-delete" title="Delete"
                                           asp-controller="@ControllerConstants.USER_CONTROLLER"
                                           asp-action="Delete"
                                           asp-area="@AreaConstants.ADMIN_AREA"
                                           asp-route-id="@item.Key.Id">
                                            <span class="fas fa-trash-alt"></span>
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <p>No Actions</p>
                                }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center align-items-center mt-3">

        @if (Model.UsersRoles.Any())
        {
            @if (Model.Pagination.Page > 1)
            {
                <a class="btn btn-sm btn-falcon-default me-1" title="Previous"
                   asp-controller="@ControllerConstants.ACTOR_CONTROLLER"
                   asp-action="Index"
                   asp-area="@AreaConstants.ADMIN_AREA"
                   asp-route-Pagination.Page="@(Model.Pagination.Page - 1)"
                   asp-route-Pagination.PageSize="@Model.Pagination.PageSize"
                   asp-route-search="@Model.Search">
                    <span class="fas fa-chevron-left"></span>
                </a>
            }

            if (Model.Pagination.TotalPages > 1)
            {
                <ul class="pagination mb-0">
                    @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                    {
                        <li class="page-item @(Model.Pagination.Page == i ? "active" : "")">
                            <a class="page btn btn-sm @(Model.Pagination.Page == i ? "btn-falcon-primary" : "btn-falcon-default") me-1"
                               asp-controller="@ControllerConstants.ACTOR_CONTROLLER"
                               asp-action="Index"
                               asp-area="@AreaConstants.ADMIN_AREA"
                               asp-route-Pagination.Page="@i"
                               asp-route-Pagination.PageSize="@Model.Pagination.PageSize"
                               asp-route-search="@Model.Search">@i</a>
                        </li>
                    }
                </ul>
            }

            @if (Model.Pagination.Page < Model.Pagination.TotalPages)
            {
                <a class="btn btn-sm btn-falcon-default ms-1" title="Next"
                   asp-controller="@ControllerConstants.ACTOR_CONTROLLER"
                   asp-action="Index"
                   asp-area="@AreaConstants.ADMIN_AREA"
                   asp-route-Pagination.Page="@(Model.Pagination.Page + 1)"
                   asp-route-Pagination.PageSize="@Model.Pagination.PageSize"
                   asp-route-search="@Model.Search">
                    <span class="fas fa-chevron-right"></span>
                </a>
            }
        }
    </div>
</div>

@section DeleteConfirmation {
    <partial name="_ConfirmationDialogPartial" />
}

@section Notification {
    <partial name="_NotificationPartial" />
}
