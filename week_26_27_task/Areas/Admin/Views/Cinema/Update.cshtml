@model CinemaWithImageVm

<form method="post" enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="Cinema.Name" class="form-label"></label>
        <input asp-for="Cinema.Name" class="form-control" minlength="3" maxlength="100" />
        <div class="form-text">Required, between 3 and 100 characters.</div>
        <span class="text-danger" asp-validation-for="Cinema.Name"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Cinema.Location" class="form-label"></label>
        <textarea asp-for="Cinema.Location" class="form-control" rows="3" maxlength="1000"></textarea>
        <div class="form-text">Optional, up to 1000 characters.</div>
        <span class="text-danger" asp-validation-for="Cinema.Location"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Image" class="form-label"></label>
        <input asp-for="Image" type="file" class="form-control" accept="image/*" id="imageInput" />
        <span class="text-danger" asp-validation-for="Image"></span>
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Image Preview</label>
        @if (string.IsNullOrEmpty(Model.Cinema?.Img))
        {
            <img id="imagePreview"
                 src="#"
                 alt="Cinema Image Preview"
                 class="rounded shadow-sm"
                 style="width: 120px; height: 120px; object-fit: cover;" />
        }
        else
        {
            <img id="imagePreview"
                 src="~/assets/images/cinema/@Model.Cinema.Img"
                 alt="Cinema Image Preview"
                 class="rounded shadow-sm"
                 style="width: 120px; height: 120px; object-fit: cover;" />
        }
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');

            @{
                var originalSrcValue = $"~/assets/images/cinema/{Model.Cinema.Img}";
            }
            const originalSrc = "@originalSrcValue";

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = originalSrc;
            }
        });
    </script>
}
