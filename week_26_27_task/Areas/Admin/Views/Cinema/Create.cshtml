@model CinemaWithResources

<form method="post" enctype="multipart/form-data">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Cinema.Name" class="form-label"></label>
        <input asp-for="Cinema.Name" class="form-control" minlength="3" maxlength="100" />
        <div class="form-text">Required, between 3 and 100 characters.</div>
        <span class="text-danger" asp-validation-for="Cinema.Name"></span>
    </div>
  
    <div class="mb-3">
        <label asp-for="Cinema.Location" class="form-label"></label>
        <textarea asp-for="Cinema.Location" class="form-control" rows="3" maxlength="1000"></textarea>
        <div class="form-text">Required, up to 1000 characters.</div>
        <span class="text-danger" asp-validation-for="Cinema.Location"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Image" class="form-label"></label>
        <input asp-for="Image" type="file" class="form-control" accept="image/*" id="imageInput" />
        <span class="text-danger" asp-validation-for="Image"></span>
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Image Preview</label>
        <img id="imagePreview" 
             src="#" 
             alt="Selected Image Preview" 
             class="rounded shadow-sm d-none" 
             style="width: 120px; height: 120px; object-fit: cover;" />
    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-center mb-1">
        <h5 class="mb-0">Auditoriums</h5>
        <button type="button" class="btn btn-sm btn-falcon-primary" id="addAuditorium">
            <span class="fas fa-plus" data-fa-transform="shrink-3 down-2"></span><span class="ms-1">Add auditorium</span>
        </button>
    </div>
    <div class="form-text mb-3">
        Add at least one auditorium. For each auditorium enter its name, the number of rows (A - Z) and the number of columns. Seats are generated automatically.
    </div>

    <div id="auditoriums"></div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = '#';
                preview.classList.add('d-none');
            }
        });

        const auditoriumsContainer = document.getElementById('auditoriums');

        const auditoriumTemplate = `
            <div class="col-12 col-md-4">
                <label class="form-label">Auditorium name</label>
                <input data-field="Name" class="form-control" maxlength="100" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">Rows</label>
                <input data-field="Rows" type="number" min="1" max="26" value="1" class="form-control" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">Columns</label>
                <input data-field="Columns" type="number" min="1" max="120" value="1" class="form-control" />
            </div>
            <div class="col-12 col-md-2 text-end">
                <button type="button" class="btn btn-sm btn-falcon-danger remove-auditorium" title="Remove">
                    <span class="fas fa-trash-alt"></span>
                </button>
            </div>`;

        function reindexAuditoriums() {
            Array.from(auditoriumsContainer.querySelectorAll('.auditorium-row')).forEach(function (row, index) {
                row.querySelectorAll('[data-field]').forEach(function (input) {
                    input.name = 'CreateAuditorium[' + index + '].' + input.dataset.field;
                });
            });
        }

        function addAuditoriumRow() {
            const row = document.createElement('div');
            row.className = 'row g-2 align-items-end border rounded p-2 mb-2 auditorium-row';
            row.innerHTML = auditoriumTemplate;
            auditoriumsContainer.appendChild(row);
            reindexAuditoriums();
        }

        auditoriumsContainer.addEventListener('click', function (event) {
            const removeButton = event.target.closest('.remove-auditorium');

            if (removeButton) {
                removeButton.closest('.auditorium-row').remove();
                reindexAuditoriums();
            }
        });

        document.getElementById('addAuditorium').addEventListener('click', addAuditoriumRow);

        addAuditoriumRow();
    </script>
}
