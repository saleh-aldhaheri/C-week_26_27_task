@model week_26_27.ViewModels.ForgetPasswordVM

<h4>Forget Password</h4>

<form asp-action="ForgetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EmailOrUsername" class="form-label"></label>
        <input asp-for="EmailOrUsername" class="form-control" />
        <span class="text-danger" asp-validation-for="EmailOrUsername"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send reset email</button>
    <a asp-action="Login" class="btn btn-link">Back to login</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Notification {
    <partial name="_NotificationPartial" />
}
