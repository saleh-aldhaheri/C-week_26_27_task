@model week_26_27.ViewModels.ForgetPasswordVM
@{
    ViewData["Title"] = "Forget Password";
}

<h1>@ViewData["Title"]</h1>

<form asp-action="ForgetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EmailOrPassword" class="form-label"></label>
        <input asp-for="EmailOrPassword" class="form-control" />
        <span asp-validation-for="EmailOrPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send Reset Email</button>
    <a asp-action="Login" class="btn btn-link">Back to Login</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Notifications { 
    <partial name="_NotificationPartial" />
}
