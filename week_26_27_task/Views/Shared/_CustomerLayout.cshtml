<!DOCTYPE html>
<html lang="en-US" dir="ltr" data-bs-theme="light">

  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@(ViewData["Title"] ?? "Cinema")</title>

    <link rel="icon" type="image/png" sizes="32x32" href="~/admin/assets/img/favicons/favicon-32x32.png">
    <link rel="shortcut icon" type="image/x-icon" href="~/admin/assets/img/favicons/favicon.ico">

    <script src="~/admin/assets/js/config.js"></script>
    <script src="~/admin/vendors/simplebar/simplebar.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700%7cPoppins:300,400,500,600,700,800,900&amp;display=swap" rel="stylesheet">
    <link href="~/admin/vendors/simplebar/simplebar.min.css" rel="stylesheet">
    <link href="~/admin/assets/css/theme-rtl.min.css" rel="stylesheet" id="style-rtl">
    <link href="~/admin/assets/css/theme.min.css" rel="stylesheet" id="style-default">
    <link href="~/admin/assets/css/user-rtl.min.css" rel="stylesheet" id="user-style-rtl">
    <link href="~/admin/assets/css/user.min.css" rel="stylesheet" id="user-style-default">
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
    <script>
      var isRTL = JSON.parse(localStorage.getItem('isRTL'));
      if (isRTL) {
        var linkDefault = document.getElementById('style-default');
        var userLinkDefault = document.getElementById('user-style-default');
        linkDefault.setAttribute('disabled', true);
        userLinkDefault.setAttribute('disabled', true);
        document.querySelector('html').setAttribute('dir', 'rtl');
      } else {
        var linkRTL = document.getElementById('style-rtl');
        var userLinkRTL = document.getElementById('user-style-rtl');
        linkRTL.setAttribute('disabled', true);
        userLinkRTL.setAttribute('disabled', true);
      }
    </script>

    <style>
      .customer-hero {
        position: relative;
        margin-bottom: 1.5rem;
      }

      .customer-hero .carousel-item {
        height: 340px;
        background-size: cover;
        background-position: center;
      }

      .customer-hero .carousel-item::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(11, 23, 39, 0.85), rgba(11, 23, 39, 0.15));
      }

      .customer-hero .hero-caption {
        position: relative;
        z-index: 2;
        height: 100%;
        max-width: 560px;
      }

      html,
      body {
        max-width: 100%;
        overflow-x: hidden;
      }

      .main {
        min-height: 100vh;
        max-width: 100%;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
      }

      .customer-content {
        flex: 1 0 auto;
        padding-bottom: 1.5rem;
      }

      .footer {
        flex-shrink: 0;
      }

      .movie-card {
        max-width: 230px;
        margin-left: auto;
        margin-right: auto;
        transition: transform .15s ease, box-shadow .15s ease;
        overflow: hidden;
      }

      .movie-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 .6rem 1.2rem rgba(0, 0, 0, .15) !important;
      }

      .movie-poster {
        position: relative;
        width: 100%;
        padding-top: 140%;
        background: #e9ecef;
      }

      .movie-poster img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .customer-footer {
        flex-shrink: 0;
        margin-top: auto;
        border-top: 1px solid #e5e7eb;
        text-align: center;
        padding: 1rem;
        color: #6b7280;
        font-size: .85rem;
      }

      .hero-slide-1 { background-image: linear-gradient(135deg, #1f3a93, #8022a8); }
      .hero-slide-2 { background-image: linear-gradient(135deg, #0b6e4f, #1b9aaa); }
      .hero-slide-3 { background-image: linear-gradient(135deg, #8e2de2, #e2436b); }
    </style>
  </head>

  <body>

    <main class="main" id="top">

      <nav class="navbar navbar-light navbar-glass navbar-top navbar-expand-lg">
        <a class="navbar-brand me-1 me-sm-3"
           asp-area="@AreaConstants.CUSTOMER_AREA"
           asp-controller="@ControllerConstants.HOME_CONTROLLER"
           asp-action="Index">
          <div class="d-flex align-items-center">
            <img class="me-2" src="~/admin/assets/img/icons/spot-illustrations/falcon.png" alt="" width="40" />
            <span class="font-sans-serif">Cinema</span>
          </div>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNav" aria-controls="customerNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse flex-grow-1 justify-content-between" id="customerNav">
          <ul class="navbar-nav align-items-center ms-auto gap-2 px-4">
            <li class="nav-item">
              <div class="theme-control-toggle fa-icon-wait px-2">
                <input class="form-check-input ms-0 theme-control-toggle-input" id="themeControlToggle" type="checkbox" data-theme-control="theme" value="dark" />
                <label class="mb-0 theme-control-toggle-label theme-control-toggle-light" for="themeControlToggle" data-bs-toggle="tooltip" data-bs-placement="left" title="Switch to light theme"><span class="fas fa-sun fs-0"></span></label>
                <label class="mb-0 theme-control-toggle-label theme-control-toggle-dark" for="themeControlToggle" data-bs-toggle="tooltip" data-bs-placement="left" title="Switch to dark theme"><span class="fas fa-moon fs-0"></span></label>
              </div>
            </li>
            @if (User.Identity?.IsAuthenticated == true)
            {
              <li class="nav-item">
                <a class="btn btn-sm btn-falcon-default" asp-area="@AreaConstants.IDENTITY_AREA" asp-controller="@ControllerConstants.ACCOUNT_CONTROLLER" asp-action="Logout" title="Logout">
                  <span class="fas fa-sign-out-alt me-1"></span>Logout
                </a>
              </li>
            }
            else
            {
              <li class="nav-item">
                <a class="btn btn-sm btn-falcon-primary" asp-area="@AreaConstants.IDENTITY_AREA" asp-controller="@ControllerConstants.ACCOUNT_CONTROLLER" asp-action="Register" title="Sign Up">
                  <span class="fas fa-user-plus me-1"></span>Sign Up
                </a>
              </li>
              <li class="nav-item">
                <a class="btn btn-sm btn-primary" asp-area="@AreaConstants.IDENTITY_AREA" asp-controller="@ControllerConstants.ACCOUNT_CONTROLLER" asp-action="Login" title="Sign In">
                  <span class="fas fa-sign-in-alt me-1"></span>Sign In
                </a>
              </li>
            }
          </ul>
        </div>
      </nav>

      @{
        var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
        var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
        var routeArea = ViewContext.RouteData.Values["area"]?.ToString();
        var showHero = string.Equals(routeAction, "Index", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(routeController, "Home", StringComparison.OrdinalIgnoreCase)
                    && string.Equals(routeArea, AreaConstants.CUSTOMER_AREA, StringComparison.OrdinalIgnoreCase);
      }

      @if (showHero)
      {
        <section class="customer-hero">
          <div id="customerHero" class="carousel slide carousel-fade" data-bs-ride="carousel">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#customerHero" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#customerHero" data-bs-slide-to="1" aria-label="Slide 2"></button>
            </div>

            <div class="carousel-inner">
              <div class="carousel-item active hero-slide-1">
                <div class="container h-100">
                  <div class="hero-caption d-flex flex-column justify-content-center text-white">
                    <h1 class="text-white mb-2">Now Showing</h1>
                    <p class="fs-1 mb-4">Book your favourite movie tickets in seconds.</p>
                    <div>
                      <a class="btn btn-primary btn-lg" asp-area="@AreaConstants.CUSTOMER_AREA" asp-controller="@ControllerConstants.HOME_CONTROLLER" asp-action="Index">Book Now</a>
                    </div>
                  </div>
                </div>
              </div>

              <div class="carousel-item hero-slide-2">
                <div class="container h-100">
                  <div class="hero-caption d-flex flex-column justify-content-center text-white">
                    <h1 class="text-white mb-2">Coming Soon</h1>
                    <p class="fs-1 mb-4">Get ready for the biggest releases of the year.</p>
                    <div>
                      <a class="btn btn-primary btn-lg" asp-area="@AreaConstants.CUSTOMER_AREA" asp-controller="@ControllerConstants.HOME_CONTROLLER" asp-action="Index">Book Now</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#customerHero" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#customerHero" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
          </div>
        </section>
      }

      <div class="container-fluid px-3 px-lg-5 customer-content">
        @RenderBody()
      </div>

      <footer class="customer-footer">
        &copy; @DateTime.Now.Year - Cinema
      </footer>

    </main>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/admin/vendors/popper/popper.min.js"></script>
    <script src="~/admin/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/admin/vendors/anchorjs/anchor.min.js"></script>
    <script src="~/admin/vendors/is/is.min.js"></script>
    <script src="~/admin/vendors/fontawesome/all.min.js"></script>
    <script src="~/admin/vendors/lodash/lodash.min.js"></script>
    <script src="~/admin/assets/js/theme.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @RenderSection("Scripts", required: false)
    @RenderSection("Notification", required: false)
  </body>

</html>
